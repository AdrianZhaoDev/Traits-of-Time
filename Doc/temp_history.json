{
  "events": [
    {
      "id": "E_HIST_1641_LUOYANG",
      "title": "王府开仓",
      "text": "洛阳城破，福王身亡，王府存粮分给饥民。你赶到粮场，肚子先替你排起了队。",
      "trigger": { "kind": "historical", "year": 1641, "priority": 100 },
      "interaction": "choice",
      "options": [
        {
          "id": "queue",
          "text": "排队领粮，先顾肚子",
          "unavailable_text": "粮场已经停止分粮。",
          "risk": "safe",
          "outcome": {
            "text": "你领到一小袋粮，回去熬成稀粥。碗里能照见人影，好歹不是空碗照镜子。",
            "effects": [{ "type": "attribute_add", "attribute": "physique", "amount": 1 }],
            "next_stage_id": null
          }
        },
        {
          "id": "carry",
          "text": "帮忙搬粮，分给街坊",
          "unavailable_text": "粮袋已经搬完，无需帮手。",
          "risk": "normal",
          "outcome": {
            "text": "你扛粮扛得肩膀发酸，替街坊多跑了几趟。大家记住了你，腰也记住了今天。",
            "effects": [
              { "type": "attribute_add", "attribute": "physique", "amount": -1 },
              { "type": "attribute_add", "attribute": "prestige", "amount": 2 }
            ],
            "next_stage_id": null
          }
        },
        {
          "id": "climb",
          "text": "翻墙抢粮，小心跌落丧命",
          "unavailable_text": "粮仓墙边已经封住。",
          "risk": "high",
          "outcome": {
            "text": "你想翻墙抄近路抢粮，旧砖却先散了架。粮袋还没摸到，人已跌落，再没起来。",
            "effects": [
              { "type": "flag_add", "id": "F_HIST_GRAIN_ROBBED" },
              { "type": "death", "id": "D_HIST_LOOT_FALL" }
            ],
            "next_stage_id": null
          }
        }
      ]
    },
    {
      "id": "E_HIST_1642_FLOOD",
      "title": "水退找路",
      "text": "开封围城期间，黄河决堤，城里城外都遭了灾。水退之后，你得给下一顿找个落脚处。",
      "trigger": { "kind": "historical", "year": 1642, "priority": 100 },
      "interaction": "choice",
      "options": [
        {
          "id": "high_ground",
          "text": "上高地搭棚，烧水等粮",
          "unavailable_text": "附近已无可用的落脚高地。",
          "risk": "safe",
          "outcome": {
            "text": "你拿破门板搭了棚，先烧水再找吃的。家当缩水得厉害，好在人没有跟着缩水。",
            "effects": [
              { "type": "attribute_add", "attribute": "wealth", "amount": -1 },
              { "type": "flag_add", "id": "F_HIST_FLOOD_SURVIVE" }
            ],
            "next_stage_id": null
          }
        },
        {
          "id": "clear_road",
          "text": "帮人清路，换点干粮",
          "unavailable_text": "清路队已经收工。",
          "risk": "normal",
          "outcome": {
            "text": "你挖开淤泥，帮邻居找回几件家什。挣来的干粮硬得硌牙，但总算轮到牙齿干活。",
            "effects": [
              { "type": "attribute_add", "attribute": "physique", "amount": -1 },
              { "type": "attribute_add", "attribute": "prestige", "amount": 2 },
              { "type": "flag_add", "id": "F_HIST_FLOOD_SURVIVE" }
            ],
            "next_stage_id": null
          }
        }
      ]
    },
    {
      "id": "E_HIST_1643_PLAGUE_NORTH",
      "title": "求药避疫",
      "text": "京师和北地疫病蔓延，药铺门口排起长队。你摸摸钱袋，发现药钱比自己的底气还足。",
      "trigger": { "kind": "historical", "year": 1643, "priority": 100 },
      "interaction": "choice",
      "options": [
        {
          "id": "seek_doctor",
          "text": "拿两份积蓄请郎中",
          "condition": { "op": "compare", "field": "wealth", "comparator": ">=", "value": 2 },
          "unavailable_text": "财力不足两份，付不起诊费药钱。",
          "risk": "safe",
          "outcome": {
            "text": "郎中看过病，让你服药休息。几日后人缓了过来，钱袋倒还病着，暂时不想见人。",
            "effects": [
              { "type": "attribute_add", "attribute": "wealth", "amount": -2 },
              { "type": "flag_add", "id": "F_HIST_PLAGUE_RECOVER" }
            ],
            "next_stage_id": null
          }
        },
        {
          "id": "keep_distance",
          "text": "少去人堆，烧水换洗",
          "unavailable_text": "眼下没有安顿休息的地方。",
          "risk": "normal",
          "outcome": {
            "text": "你少出门，勤换洗，把水烧开再喝。躲过这阵风波，饭碗却因少做几天工而见了底。",
            "effects": [{ "type": "attribute_add", "attribute": "wealth", "amount": -1 }],
            "next_stage_id": null
          }
        },
        {
          "id": "share_medicine",
          "text": "拿三份积蓄凑药照应邻居",
          "condition": { "op": "compare", "field": "wealth", "comparator": ">=", "value": 3 },
          "unavailable_text": "财力不足三份，无法替邻居垫药钱。",
          "risk": "normal",
          "outcome": {
            "text": "你帮邻居请医送药，送到门边就走。大家欠下一笔人情，只有药铺掌柜坚持当场结账。",
            "effects": [
              { "type": "attribute_add", "attribute": "wealth", "amount": -3 },
              { "type": "attribute_add", "attribute": "prestige", "amount": 3 }
            ],
            "next_stage_id": null
          }
        }
      ]
    },
    {
      "id": "E_HIST_1644_JASHEN_FALL",
      "title": "京城换旗",
      "text": "甲申三月，京师陷落，李自成进京后追赃助饷。街坊忙着藏账本，你也得想想往哪站。",
      "trigger": { "kind": "historical", "year": 1644, "priority": 200 },
      "interaction": "choice",
      "options": [
        {
          "id": "keep_accounts",
          "text": "去当书办，只管登记账目",
          "unavailable_text": "登记账目的差事已经满员。",
          "risk": "normal",
          "outcome": {
            "text": "你领了书办差事，整天登记钱粮。别人问前程，你看看越堆越高的账本，决定先闭嘴。",
            "effects": [
              { "type": "flag_add", "id": "F_HIST_REBELS_OFFICIAL" },
              { "type": "attribute_add", "attribute": "wealth", "amount": 1 },
              { "type": "attribute_add", "attribute": "prestige", "amount": -1 }
            ],
            "next_stage_id": null
          }
        },
        {
          "id": "outskirts",
          "text": "收拾铺盖，暂住城郊",
          "unavailable_text": "城郊的落脚处暂时进不去。",
          "risk": "safe",
          "outcome": {
            "text": "你把值钱家当换成干粮，搬到城郊借住。没赶上新差事，倒是赶上了房东催房钱。",
            "effects": [{ "type": "attribute_add", "attribute": "wealth", "amount": -1 }],
            "next_stage_id": null
          }
        },
        {
          "id": "settle_accounts",
          "text": "拿出旧账，按要求交粮",
          "unavailable_text": "登记钱粮的窗口已经关闭。",
          "risk": "normal",
          "outcome": {
            "text": "你把账本摊开，该交的粮照数交了。手续办完心里松快些，灶台却开始认真考虑歇业。",
            "effects": [
              { "type": "attribute_add", "attribute": "wealth", "amount": -2 },
              { "type": "attribute_add", "attribute": "intelligence", "amount": 1 }
            ],
            "next_stage_id": null
          }
        }
      ]
    },
    {
      "id": "E_HIST_1644_SHANHAI_PASS",
      "title": "关口变天",
      "text": "四月山海关战局突变，吴三桂与清军合兵，随后清军入关。北边道路更乱，你的行李又得打包。",
      "trigger": { "kind": "historical", "year": 1644, "priority": 100 },
      "interaction": "choice",
      "options": [
        {
          "id": "leave_north",
          "text": "避开大路，随难民南下",
          "unavailable_text": "南下的同行人已经动身。",
          "risk": "normal",
          "outcome": {
            "text": "你绕过兵马来往的大路，终于走到江南。鞋底先撑不住了，好在人还能继续讨生活。",
            "effects": [
              { "type": "attribute_add", "attribute": "wealth", "amount": -2 },
              { "type": "flag_add", "id": "F_HIST_CAPITAL_FLED" },
              { "type": "flag_remove", "id": "F_HIST_REBELS_OFFICIAL" },
              { "type": "region_set", "id": "R_JIANGNAN" }
            ],
            "next_stage_id": null
          }
        },
        {
          "id": "escort_neighbors",
          "text": "带上街坊，一起绕道南下",
          "unavailable_text": "街坊已经另找了同行队伍。",
          "risk": "normal",
          "outcome": {
            "text": "你领着街坊走小路，到江南时腿都抬不动。大家夸你认路，你只想先认一张能睡的床。",
            "effects": [
              { "type": "attribute_add", "attribute": "physique", "amount": -1 },
              { "type": "attribute_add", "attribute": "prestige", "amount": 2 },
              { "type": "flag_add", "id": "F_HIST_CAPITAL_FLED" },
              { "type": "flag_remove", "id": "F_HIST_REBELS_OFFICIAL" },
              { "type": "region_set", "id": "R_JIANGNAN" }
            ],
            "next_stage_id": null
          }
        }
      ]
    },
    {
      "id": "E_HIST_1645_NANJING_COURT",
      "title": "朝堂抢位",
      "text": "南京弘光朝里，拥立旧账和立储议论搅成一团，各派忙着争权。你递张求粮条子，还得先认门。",
      "trigger": { "kind": "historical", "year": 1645, "priority": 300 },
      "interaction": "choice",
      "options": [
        {
          "id": "support_relief",
          "text": "支持朝廷，拿两份积蓄赈粮",
          "condition": { "op": "compare", "field": "wealth", "comparator": ">=", "value": 2 },
          "unavailable_text": "财力不足两份，凑不起这批粮。",
          "risk": "normal",
          "outcome": {
            "text": "你出钱帮忙赈粮，盼朝廷少吵两句。粮送到了百姓手里，衙门里的嗓门却没见省。",
            "effects": [
              { "type": "attribute_add", "attribute": "wealth", "amount": -2 },
              { "type": "attribute_add", "attribute": "prestige", "amount": 2 },
              { "type": "flag_add", "id": "F_HIST_NANMING_LOYAL" }
            ],
            "next_stage_id": null
          }
        },
        {
          "id": "petition",
          "text": "替街坊递求粮条子",
          "unavailable_text": "衙门今日已经不再收条子。",
          "risk": "normal",
          "outcome": {
            "text": "你替街坊跑了几处衙门，终于递上求粮条子。答复还得等，倒是门房认全了你的脸。",
            "effects": [
              { "type": "attribute_add", "attribute": "prestige", "amount": 1 },
              { "type": "attribute_add", "attribute": "physique", "amount": -1 }
            ],
            "next_stage_id": null
          }
        },
        {
          "id": "earn_living",
          "text": "不掺和争位，码头找活",
          "unavailable_text": "码头今天已经不再招工。",
          "risk": "safe",
          "outcome": {
            "text": "你绕开说客，去码头帮人扛包。谁坐哪把椅子还没定，你晚饭坐哪张凳子倒是有了着落。",
            "effects": [{ "type": "attribute_add", "attribute": "wealth", "amount": 1 }],
            "next_stage_id": null
          }
        }
      ]
    },
    {
      "id": "E_HIST_1645_YANGZHOU_FATE",
      "title": "城下去留",
      "text": "四月，清军逼近扬州，史可法组织守城。去留摆在眼前，你的行李不重，心里的算盘却拨不动。",
      "trigger": { "kind": "historical", "year": 1645, "priority": 200 },
      "interaction": "choice",
      "options": [
        {
          "id": "leave_early",
          "text": "趁道路尚通，去乡下落脚",
          "unavailable_text": "通往乡下的道路已经封闭。",
          "risk": "safe",
          "outcome": {
            "text": "你趁道路还通离开城边，借住乡下旧屋。屋顶漏雨总能补，比等着粮缸自己长米靠谱。",
            "effects": [
              { "type": "attribute_add", "attribute": "wealth", "amount": -1 },
              { "type": "region_set", "id": "R_JIANGNAN" },
              { "type": "flag_add", "id": "F_HIST_HERMIT_SOUTH" }
            ],
            "next_stage_id": null
          }
        },
        {
          "id": "help_departures",
          "text": "帮老幼搬行李，再一起走",
          "unavailable_text": "撤离的队伍已经离开。",
          "risk": "normal",
          "outcome": {
            "text": "你帮老幼扛着包袱赶路，离开时已满脚水泡。大家平安落脚，你决定暂时不跟鞋子说话。",
            "effects": [
              { "type": "attribute_add", "attribute": "physique", "amount": -2 },
              { "type": "attribute_add", "attribute": "prestige", "amount": 3 },
              { "type": "region_set", "id": "R_JIANGNAN" },
              { "type": "flag_add", "id": "F_HIST_NANMING_LOYAL" }
            ],
            "next_stage_id": null
          }
        },
        {
          "id": "stay_without_food",
          "text": "缺粮仍守旧屋，可能饿死",
          "unavailable_text": "旧屋已经无法居住。",
          "risk": "high",
          "outcome": {
            "text": "你舍不得旧屋，等到围困加紧才想走。家中早已断粮，身体撑不住，没能等来救济。",
            "effects": [{ "type": "death", "id": "D_HIST_SIEGE_STARVE" }],
            "next_stage_id": null
          }
        }
      ]
    },
    {
      "id": "E_HIST_1645_HAIRCUT",
      "title": "发令到村",
      "text": "六月，剃发令传到江南，各地有人照办，有人抗拒，也有人躲避。街口议论不断，你得考虑安身。",
      "trigger": { "kind": "historical", "year": 1645, "priority": 100 },
      "interaction": "choice",
      "options": [
        {
          "id": "comply",
          "text": "按令剃发，先安顿家人",
          "unavailable_text": "街口理发摊已经收起工具。",
          "risk": "safe",
          "outcome": {
            "text": "你按要求剃了发，带家人回去关门做饭。街上的议论没停，家里的日子还得一顿顿过。",
            "effects": [{ "type": "attribute_add", "attribute": "wealth", "amount": -1 }],
            "next_stage_id": null
          }
        },
        {
          "id": "hide_south",
          "text": "暂避乡间，不进城凑热闹",
          "unavailable_text": "乡间借住的人家已经搬走。",
          "risk": "normal",
          "outcome": {
            "text": "你躲到偏远村里，靠帮人种菜换饭。眼下避开了盘查，往后怎么过，还得留意外头消息。",
            "effects": [
              { "type": "attribute_add", "attribute": "wealth", "amount": -2 },
              { "type": "flag_add", "id": "F_HIST_HERMIT_SOUTH" },
              { "type": "region_set", "id": "R_JIANGNAN" }
            ],
            "next_stage_id": null
          }
        },
        {
          "id": "argue_at_gate",
          "text": "滞留街口抗拒，可能丧命",
          "unavailable_text": "街口已经禁止行人停留。",
          "risk": "high",
          "outcome": {
            "text": "你留在街口争辩，被带走拘押。连日缺少照料，旧病加重，最终没能再回到家中。",
            "effects": [{ "type": "death", "id": "D_HIST_HAIR_RESIST" }],
            "next_stage_id": null
          }
        }
      ]
    }
  ]
}
