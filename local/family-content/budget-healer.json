  "chains": [
    {
      "id": "CHAIN_MOD_HEALER_SAGE",
      "name": "医圣守册",
      "commitment": "历时六年，起步免费，第1、3、6年自动学习用药范围、清洁和协作照护，清洁时仍需检定。重大抉择可推广照护、交药、冒险或暂停；整板药交出后只留手册，自诊或独自带药遇险可能丧命。可手动放弃进行中的事业，重伤或道路封闭也会中断；已学经验保留。1643至1644年开局改走甲申自动救助任务。",
      "priority": 80,
      "interrupt_condition": {
        "op": "any",
        "conditions": [
          { "op": "has", "collection": "flags", "id": "F_MOD_HEALER_ABORT" },
          { "op": "has", "collection": "injuries", "id": "INJ_SEVERE" },
          { "op": "has", "collection": "flags", "id": "F_ERA_ROADS_CLOSED" }
        ]
      },
      "interrupt_text": "协诊暂告中断，有限的药片不能随意分发，学会的照护方法仍然保留。",
      "nodes": [
        { "after_years": 1, "event_id": "E_MOD_HEALER_NODE_1" },
        { "after_years": 3, "event_id": "E_MOD_HEALER_NODE_2" },
        { "after_years": 6, "event_id": "E_MOD_HEALER_NODE_3" }
      ],
      "completion": {
        "text": "你学会了照册分工，也知道何时必须请郎中，不能只凭药盒行事。",
        "effects": [{ "type": "flag_add", "id": "F_MOD_HEALER_MAIN_DONE" }],
        "next_stage_id": null
      }
    }
  ],
  "reasons": {
    "E_MOD_HEALER_NODE_1": "普通跟诊改为原第一项的自动结果，药品消费、自诊危险和退出移至重大菜单，不额外花选择预算。",
    "E_MOD_HEALER_NODE_2": "保留第一项和真实S_HYGIENE检定，自动完成清洁照护进展。",
    "E_MOD_HEALER_NODE_3": "保留第一项的救助、准备与成长结果，携药独行危险移至重大菜单。",
    "E_MOD_HEALER_FAST_1": "晚开局保留原第一项自动分诊、中断普通链及快进标记；交药集中到重大菜单。",
    "E_MOD_HEALER_FAST_2": "保留原第一项自动分区及真实S_WATER检定，延续快进依赖。",
    "E_MOD_HEALER_FAST_3": "保留原第一项自动完成交接与准备；快进和普通独行危险合并至重大菜单。",
    "E_MOD_HEALER_BREAKTHROUGH": "与历史重大事件共用一次选择；保留推广原门槛及D20，迁入真实交药、主动自诊、携药独行和退出，死亡检定及成就标记仍可到达。",
    "CHAIN_MOD_HEALER_SAGE": "仅修订承诺文本，准确描述自动进展、集中抉择、检定、消耗与中断；节点、完成和中断配置不变。"
  }
}
