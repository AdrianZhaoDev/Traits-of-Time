{
  "events": [
    {
      "id": "E_MOD_HEALER_NODE_1",
      "title": "有限的药片",
      "text": "邻居端着碗来排队求药，郎中拦住大家：药片不多，得先看病症能不能用。",
      "trigger": { "kind": "chain" },
      "interaction": "automatic",
      "outcome": {
        "text": "你跟着郎中逐个核对病症，弄清哪些情况能用药、哪些不能。",
        "effects": [
          { "type": "flag_add", "id": "F_MOD_HEALER_BOUNDARY" },
          { "type": "attribute_add", "attribute": "intelligence", "amount": 3 },
          { "type": "attribute_add", "attribute": "prestige", "amount": 3 }
        ],
        "next_stage_id": null
      }
    },
    {
      "id": "E_MOD_HEALER_NODE_2",
      "title": "饮水和洗具分开",
      "text": "临时照护处挤满了人，连清洗用的盆也拿来盛饮水。得先把照护和清洁安排好。",
      "trigger": { "kind": "chain" },
      "interaction": "automatic",
      "outcome": {
        "text": "你跟郎中划分照护区域，分清哪些锅盆盛饮水，哪些用来清洗。",
        "effects": [
          { "type": "flag_add", "id": "F_MOD_HEALER_HYGIENE" },
          { "type": "attribute_add", "attribute": "intelligence", "amount": 3 },
          { "type": "attribute_add", "attribute": "prestige", "amount": 3 }
        ],
        "next_stage_id": "S_HYGIENE"
      },
      "stages": [
        {
          "id": "S_HYGIENE",
          "text": "你对着桌边的手册，向郎中说明照护次序。",
          "check": { "attribute": "intelligence", "dc": 16, "modifier": 0, "tag": "medicine" },
          "success": {
            "text": "你把照护次序和分工说清了，郎中将清单贴到门板上。",
            "effects": [{ "type": "attribute_add", "attribute": "prestige", "amount": 1 }],
            "next_stage_id": null
          },
          "failure": {
            "text": "你把一处清洗顺序写反了，郎中带你重新排好，照护继续。",
            "effects": [],
            "next_stage_id": null
          }
        }
      ]
    },
    {
