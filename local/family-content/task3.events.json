[
  {
    "id": "E_FAM_WEALTH_RELATIVE_HELP",
    "title": "亲戚求助",
    "text": "远房亲戚前些日子求过一次周转，如今旧债又到期，再来商量借钱。",
    "condition": {
      "op": "all",
      "conditions": [
        {"op": "compare", "field": "age", "comparator": "gte", "value": 18},
        {"op": "compare", "field": "wealth", "comparator": "gte", "value": 8},
        {"op": "not", "condition": {"op": "has", "collection": "flags", "id": "F_FAM_WEALTH_RELIEF_HANDLED"}}
      ]
    },
    "trigger": {"kind": "random", "weight": 25, "priority": 0, "trigger_probability": 0.8, "cooldown_years": 0, "max_occurrences": 1, "rare": false},
    "interaction": "automatic",
    "outcome": {
      "text": "你拿出一笔钱应急，说好不急着催还。亲戚感激地收下，记住了这份情。",
      "effects": [
        {"type": "attribute_add", "attribute": "wealth", "amount": -1},
        {"type": "attribute_add", "attribute": "prestige", "amount": 1},
        {"type": "flag_add", "id": "F_FAM_WEALTH_RELIEF_HANDLED"}
      ],
      "next_stage_id": null
    }
  },
