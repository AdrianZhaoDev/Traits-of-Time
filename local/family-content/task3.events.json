  {
    "id": "E_FAM_WEALTH_OFFICE_HELP",
    "title": "代递自荐",
    "text": "亲戚拿着一份求官的自荐书登门，托你设法替他递进官署。",
    "condition": {
      "op": "all",
      "conditions": [
        {"op": "compare", "field": "age", "comparator": "gte", "value": 18},
        {"op": "compare", "field": "prestige", "comparator": "gte", "value": 10},
        {"op": "not", "condition": {"op": "has", "collection": "flags", "id": "F_FAM_WEALTH_OFFICE_HANDLED"}}
      ]
    },
    "trigger": {"kind": "random", "weight": 20, "priority": 0, "trigger_probability": 0.8, "cooldown_years": 0, "max_occurrences": 1, "rare": false},
    "interaction": "automatic",
    "outcome": {
      "text": "你答应按规矩代递自荐书，不许诺录用，也不替他作保。",
      "effects": [
        {"type": "flag_add", "id": "F_FAM_WEALTH_OFFICE_HANDLED"}
      ],
      "next_stage_id": "S_FAM_WEALTH_OFFICE_DELIVER"
    },
    "stages": [
      {
        "id": "S_FAM_WEALTH_OFFICE_DELIVER",
        "text": "你得问清官署收件的规矩，把自荐书递到该收的人手里。",
        "check": {"attribute": "intelligence", "dc": 14, "modifier": 0},
        "success": {
          "text": "你把自荐书交到官署，对方收下了。能否有人过目、是否任用，仍没有定论。",
          "effects": [],
          "next_stage_id": null
        },
        "failure": {
          "text": "你没能把自荐书递成，亲戚以为你不够尽心，往来冷淡了一些。",
          "effects": [
            {"type": "attribute_add", "attribute": "prestige", "amount": -1}
          ],
          "next_stage_id": null
        }
      }
    ]
  },
  {
    "id": "E_FAM_WEALTH_OFFICE_DECLINE",
