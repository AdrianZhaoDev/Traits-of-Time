          "effects": [],
          "next_stage_id": "S_FAM_END_OVERWORK_RESCUE"
        }
      },
      {
        "id": "S_FAM_END_OVERWORK_RESCUE",
        "text": "郎中留下来照看，伴侣守在床边，盼你能撑过去。",
        "check": { "attribute": "physique", "dc": 9, "modifier": 0 },
        "success": {
          "text": "熬过这阵病势，你终于缓了过来，仍需安心休养。",
          "effects": [],
          "next_stage_id": null
        },
        "failure": {
          "text": "郎中尽力救治，你还是没能挺过这场病。",
          "effects": [{ "type": "death", "id": "D_FAM_END_OVERWORK" }],
          "next_stage_id": null
        }
      }
    ]
