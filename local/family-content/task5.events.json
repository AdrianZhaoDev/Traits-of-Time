        { "op": "compare", "field": "physique", "comparator": "lte", "value": 3 },
        { "op": "has", "collection": "flags", "id": "F_FAM_MARRIED" }
      ]
    },
    "trigger": { "kind": "random", "weight": 2, "priority": 0, "trigger_probability": 0.08, "cooldown_years": 10, "max_occurrences": 1, "rare": true },
    "interaction": "automatic",
    "outcome": {
      "text": "邻居赶来破门，你得在浓烟中撑到有人接应。",
      "effects": [],
      "next_stage_id": "S_FAM_END_HOUSE_FIRE_ESCAPE"
    },
    "stages": [
      {
        "id": "S_FAM_END_HOUSE_FIRE_ESCAPE",
        "text": "烟越来越浓，你要辨清门口的方向，跟上前来接应的邻居。",
        "check": { "attribute": "physique", "dc": 11, "modifier": 0 },
        "success": {
          "text": "你和伴侣跟着邻居退到街上，总算躲过了这场火。",
          "effects": [],
          "next_stage_id": null
        },
        "failure": {
          "text": "你被浓烟呛得站不稳，邻居扶住你，继续寻找出口。",
          "effects": [],
          "next_stage_id": "S_FAM_END_HOUSE_FIRE_RESCUE"
        }
      },
      {
        "id": "S_FAM_END_HOUSE_FIRE_RESCUE",
        "text": "邻居正带你往门边走，你还得撑住这最后一段路。",
        "check": { "attribute": "physique", "dc": 9, "modifier": 0 },
        "success": {
          "text": "你被邻居扶出火场，伴侣也已退到安全处。",
          "effects": [],
          "next_stage_id": null
        },
        "failure": {
          "text": "烟雾封住退路，邻居没能及时带你出去。",
          "effects": [{ "type": "death", "id": "D_FAM_END_HOUSE_FIRE" }],
          "next_stage_id": null
        }
