{
  "name": "configurable-life-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "generate:content-types": "tsx tools/generate-content-types.ts",
    "typecheck:core": "npm run generate:content-types && tsc -p tsconfig.core.json && tsc -p tsconfig.tools.json",
    "validate:content": "tsx tools/validate-content.ts",
    "draw": "tsx tools/draw.ts",
    "play": "tsx tools/play.ts",
    "simulate": "tsx tools/simulate.ts",
    "replay": "tsx tools/replay.ts",
    "test": "vitest run",
    "test:core": "vitest run tests/core",
    "test:application": "vitest run tests/application",
    "test:content": "vitest run tests/content",
    "test:cli": "vitest run tests/cli",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.4",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
