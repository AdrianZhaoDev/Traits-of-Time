{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "strict": true,
    "baseUrl": "./",
    "types": [
      "./temp/declarations/cc.custom-macro",
      "./temp/declarations/cc",
      "./temp/declarations/jsb",
      "./temp/declarations/cc.env"
    ],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "temp/declarations/**/*.d.ts",
    "assets/scripts/**/*.ts"
  ]
}
